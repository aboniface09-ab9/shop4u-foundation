{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youcommerce",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Route all subdomain and apex traffic to this worker.
  // Prerequisite: wildcard CNAME in Cloudflare DNS:
  //   *.youcommerce.co.za  CNAME  youcommerce.co.za  (proxied)
  //   youcommerce.co.za    A      192.0.2.1           (proxied, Workers route takes over)
  "routes": [
    { "pattern": "youcommerce.co.za/app/*", "zone_name": "youcommerce.co.za" },
    { "pattern": "*.youcommerce.co.za/*", "zone_name": "youcommerce.co.za" }
  ],
  // Daily billing cron — 04:00 UTC = 06:00 SAST (SAST is UTC+2), matching
  // billing-schema.sql's own documented "checks every day at 06:00 SAST".
  // Handled by the `scheduled` export in src/server.ts.
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  // Plain (non-secret) settings. PORTAL_ORIGIN is the address used in the private quote and invoice
  // links emailed to clients, so they always point at the portal host whichever address you were on
  // when you pressed Send. Secrets (BREVO_*, SUPABASE_SERVICE_ROLE_KEY, ...) are NOT set here:
  // they are set with `wrangler secret put`.
  "vars": {
    "PORTAL_ORIGIN": "https://portal.youcommerce.co.za"
  }
}
